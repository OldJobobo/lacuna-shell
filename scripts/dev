#!/usr/bin/env python3
"""Developer utilities for Lacuna Omarchy plugins."""

from __future__ import annotations

import argparse
import filecmp
import fcntl
import os
import re
import shutil
import subprocess
import sys
from contextlib import contextmanager
from datetime import datetime, timezone
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
PLUGIN_RESCAN_COMMAND = ["omarchy", "shell", "shell", "rescanPlugins"]
PLUGIN_RESCAN_DISPLAY = " ".join(PLUGIN_RESCAN_COMMAND)
BACKUPS_TO_KEEP = 2
RUNTIME_BACKUPS_TO_KEEP = 8
PLUGIN_BACKUP_RE = re.compile(
    r"^\.(?P<plugin_id>lacuna\.[A-Za-z0-9][A-Za-z0-9._-]*)"
    r"\.bak\.(?P<timestamp>\d{14})(?:-(?P<suffix>\d+))?$"
)


def config_home() -> Path:
    """XDG root for Lacuna-owned runtime state."""
    return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))


def omarchy_config_home() -> Path:
    """Config root used by Omarchy's shell and plugin host."""
    return Path(os.environ.get("LACUNA_OMARCHY_CONFIG_HOME", Path.home() / ".config"))


def plugins_dir() -> Path:
    return omarchy_config_home() / "omarchy" / "plugins"


def plugin_backup_dir() -> Path:
    """Rollback copies kept outside the live plugin registry."""
    return config_home() / "omarchy" / "lacuna" / "backups" / "plugins"


def operation_lock_path() -> Path:
    return config_home() / "omarchy" / "lacuna" / "dev.lock"


@contextmanager
def operation_lock(blocking: bool = True):
    """Serialize deploy and backup cleanup mutations across processes."""
    path = operation_lock_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a+") as handle:
        flags = fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB)
        try:
            fcntl.flock(handle.fileno(), flags)
        except BlockingIOError as error:
            raise RuntimeError(f"Another Lacuna dev operation holds {path}") from error
        try:
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def preserve_runtime_state() -> list[Path]:
    paths = [omarchy_config_home() / "omarchy" / "shell.json", config_home() / "omarchy" / "lacuna" / "settings.json"]
    existing = [path for path in paths if path.exists() or path.is_symlink()]
    if not existing:
        return []

    backup_dir = config_home() / "omarchy" / "lacuna" / "backups"
    backup_dir.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")
    saved: list[Path] = []
    for path in existing:
        backup = backup_dir / f"{path.name}.{timestamp}.bak"
        suffix = 1
        while backup.exists() or backup.is_symlink():
            backup = backup_dir / f"{path.name}.{timestamp}-{suffix}.bak"
            suffix += 1
        if path.is_symlink():
            backup.symlink_to(os.readlink(path))
        else:
            shutil.copy2(path, backup)
        saved.append(backup)

    backups = sorted(backup_dir.glob("*.bak"), key=lambda item: (item.stat().st_mtime, item.name), reverse=True)
    for backup in backups[RUNTIME_BACKUPS_TO_KEEP * len(existing):]:
        remove_path(backup)
    for backup in saved:
        print(f"  preserved runtime state: {backup}")
    return saved


def run_command(command: list[str], dry_run: bool) -> int:
    if dry_run:
        print("  " + " ".join(command))
        return 0
    return subprocess.run(command, check=False).returncode


def remove_path(path: Path) -> None:
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)


def backup_match(path: Path) -> re.Match[str] | None:
    return PLUGIN_BACKUP_RE.fullmatch(path.name)


def backup_plugin_id(path: Path) -> str | None:
    match = backup_match(path)
    return match.group("plugin_id") if match else None


def backup_name_key(name: str) -> tuple[str, int]:
    match = PLUGIN_BACKUP_RE.fullmatch(name)
    if not match:
        return ("", -1)
    return (match.group("timestamp"), int(match.group("suffix") or 0))


def plugin_backups(plugin_id: str, include_legacy: bool = False) -> list[Path]:
    roots = [plugin_backup_dir()]
    if include_legacy:
        roots.append(plugins_dir())
    result: list[Path] = []
    for root in roots:
        if not root.is_dir():
            continue
        for path in root.iterdir():
            if backup_plugin_id(path) == plugin_id:
                result.append(path)
    return result


def prune_backups(plugin_id: str, keep: int = BACKUPS_TO_KEEP) -> None:
    backups = sorted(plugin_backups(plugin_id), key=lambda path: backup_name_key(path.name), reverse=True)
    for backup in backups[max(0, keep):]:
        remove_path(backup)


def cleanup_plugin_backups(keep: int = BACKUPS_TO_KEEP, dry_run: bool = False) -> tuple[int, int]:
    """Migrate exact legacy deploy backups out of the registry and prune globally."""
    keep = max(0, keep)
    grouped: dict[str, dict[str, list[Path]]] = {}
    for root in (plugin_backup_dir(), plugins_dir()):
        if not root.is_dir():
            continue
        for path in root.iterdir():
            plugin_id = backup_plugin_id(path)
            if plugin_id:
                grouped.setdefault(plugin_id, {}).setdefault(path.name, []).append(path)

    removals: list[tuple[Path, bool]] = []
    migrations: list[tuple[Path, Path]] = []
    for _plugin_id, by_name in sorted(grouped.items()):
        retained_names = set(sorted(by_name, key=backup_name_key, reverse=True)[:keep])
        for name, paths in sorted(by_name.items(), key=lambda item: backup_name_key(item[0]), reverse=True):
            archive_paths = [path for path in paths if path.parent == plugin_backup_dir()]
            legacy_paths = [path for path in paths if path.parent == plugins_dir()]
            if name not in retained_names:
                removals.extend((path, False) for path in paths)
                continue

            # One unique backup name consumes one retention slot. Prefer an
            # already archived copy and remove every legacy duplicate.
            if archive_paths:
                removals.extend((path, True) for path in archive_paths[1:] + legacy_paths)
                continue

            source = legacy_paths[0]
            migrations.append((source, plugin_backup_dir() / name))
            removals.extend((path, True) for path in legacy_paths[1:])

    for path, duplicate in removals:
        label = "duplicate " if duplicate else ""
        print(f"  remove {label}backup: {path}")
        if not dry_run:
            remove_path(path)

    for source, destination in migrations:
        print(f"  migrate backup: {source} -> {destination}")
        if not dry_run:
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(source), str(destination))
    return len(migrations), len(removals)


def backup_target(target: Path) -> Path | None:
    if not target.exists() and not target.is_symlink():
        return None
    timestamp = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")
    plugin_backup_dir().mkdir(parents=True, exist_ok=True)
    base = plugin_backup_dir() / f".{target.name}.bak.{timestamp}"
    backup = base
    suffix = 1
    while backup.exists() or backup.is_symlink():
        backup = plugin_backup_dir() / f"{base.name}-{suffix}"
        suffix += 1
    # This rollback copy is transaction-owned until deploy verification
    # succeeds. Retention runs only after the transaction commits.
    shutil.move(str(target), str(backup))
    return backup


def plugin_ids_from_args(args: argparse.Namespace) -> list[str]:
    if args.all:
        ids = sorted(path.name for path in ROOT.glob("lacuna.*") if (path / "manifest.json").is_file())
    else:
        ids = [item for value in args.plugins for item in value.split(",") if item]
    if not ids:
        raise SystemExit("Choose at least one plugin id, or pass --all.")

    unknown = [plugin_id for plugin_id in ids if not (ROOT / plugin_id / "manifest.json").is_file()]
    if unknown:
        raise SystemExit(f"Unknown Lacuna plugin id: {', '.join(sorted(unknown))}")

    seen: set[str] = set()
    ordered: list[str] = []
    for plugin_id in ids:
        if plugin_id not in seen:
            seen.add(plugin_id)
            ordered.append(plugin_id)
    return ordered


def relative_files(base: Path) -> dict[str, Path]:
    files: dict[str, Path] = {}
    if not base.is_dir():
        return files
    for path in sorted(base.rglob("*")):
        if "__pycache__" in path.parts:
            continue
        if path.is_file():
            files[str(path.relative_to(base))] = path
    return files


def installed_matches_source(plugin_id: str) -> tuple[bool, list[str]]:
    source = ROOT / plugin_id
    target = plugins_dir() / plugin_id
    if target.is_symlink() and target.resolve() == source.resolve():
        return True, []
    if not target.is_dir():
        return False, [f"missing installed directory: {target}"]

    source_files = relative_files(source)
    target_files = relative_files(target)
    issues: list[str] = []
    for relative in sorted(source_files.keys() - target_files.keys()):
        issues.append(f"missing installed file: {relative}")
    for relative in sorted(target_files.keys() - source_files.keys()):
        issues.append(f"extra installed file: {relative}")
    for relative in sorted(source_files.keys() & target_files.keys()):
        if not filecmp.cmp(source_files[relative], target_files[relative], shallow=False):
            issues.append(f"changed installed file: {relative}")
    return not issues, issues


def source_differs_from_install(plugin_id: str) -> bool:
    matches, _issues = installed_matches_source(plugin_id)
    return not matches


def validate_plugin(plugin_id: str, dry_run: bool) -> int:
    return run_command(["omarchy", "plugin", "validate", str(ROOT / plugin_id)], dry_run)


def deploy_plugin(
    plugin_id: str,
    dry_run: bool,
    changes: list[tuple[Path, Path | None]] | None = None,
) -> int:
    source = ROOT / plugin_id
    target = plugins_dir() / plugin_id
    print(f"  deploy {plugin_id} -> {target}", flush=True)
    code = validate_plugin(plugin_id, dry_run)
    if code != 0:
        return code
    if dry_run:
        return 0

    target.parent.mkdir(parents=True, exist_ok=True)
    stage = target.parent / f".{plugin_id}.tmp.{os.getpid()}"
    remove_path(stage)
    backup = None
    try:
        shutil.copytree(source, stage, symlinks=True, ignore=shutil.ignore_patterns("__pycache__"))
        backup = backup_target(target)
        shutil.move(str(stage), str(target))
        if changes is not None:
            changes.append((target, backup))
    except Exception as error:
        remove_path(stage)
        if backup and (backup.exists() or backup.is_symlink()) and not target.exists():
            shutil.move(str(backup), str(target))
        print(f"Failed to deploy {plugin_id}: {error}", file=sys.stderr)
        return 1
    if backup:
        print(f"    previous install backed up to {backup}")
    return 0


def rollback_deployments(changes: list[tuple[Path, Path | None]]) -> None:
    for target, backup in reversed(changes):
        remove_path(target)
        if backup and (backup.exists() or backup.is_symlink()):
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(backup), str(target))


def recover_deployment() -> int:
    print(f"  recovery: {PLUGIN_RESCAN_DISPLAY}", flush=True)
    return run_command(PLUGIN_RESCAN_COMMAND, dry_run=False)


def verify_plugins(plugin_ids: list[str], dry_run: bool) -> int:
    failed = False
    for plugin_id in plugin_ids:
        if dry_run:
            print(f"  verify {plugins_dir() / plugin_id} matches {ROOT / plugin_id}")
            continue
        matches, issues = installed_matches_source(plugin_id)
        if matches:
            print(f"  verified {plugin_id}: installed copy matches repo")
            continue
        failed = True
        print(f"  verification failed for {plugin_id}:")
        for issue in issues[:8]:
            print(f"    {issue}")
        if len(issues) > 8:
            print(f"    ... {len(issues) - 8} more issue(s)")
    return 1 if failed else 0


def _deploy(args: argparse.Namespace) -> int:
    plugin_ids = plugin_ids_from_args(args)
    if args.only_changed:
        deploy_ids = [plugin_id for plugin_id in plugin_ids if source_differs_from_install(plugin_id)]
    else:
        deploy_ids = plugin_ids

    print("Dev deploy plan")
    if deploy_ids:
        for plugin_id in deploy_ids:
            print(f"  - {plugin_id}")
    else:
        print("  Nothing selected.")

    unchanged = [plugin_id for plugin_id in plugin_ids if plugin_id not in deploy_ids]
    if unchanged:
        print(f"\nAlready deployed from this checkout: {len(unchanged)} plugin(s)")

    print("\nCommands")
    if deploy_ids:
        for plugin_id in deploy_ids:
            print(f"  deploy {plugin_id} -> {plugins_dir() / plugin_id}")
        print(f"  {PLUGIN_RESCAN_DISPLAY}")
        if args.restart_shell:
            print("  omarchy restart shell")
        print("  verify installed plugin files match this checkout")
    else:
        print("  No dev deploy commands needed.")

    if args.dry_run:
        return 0
    if not deploy_ids:
        return 0

    preserve_runtime_state()
    changes: list[tuple[Path, Path | None]] = []
    for plugin_id in deploy_ids:
        code = deploy_plugin(plugin_id, args.dry_run, changes)
        if code != 0:
            rollback_deployments(changes)
            recover_deployment()
            return code

    code = run_command(PLUGIN_RESCAN_COMMAND, args.dry_run)
    if code != 0:
        print("  plugin rescan failed; restoring the previous deployed copies", flush=True)
        rollback_deployments(changes)
        recover_deployment()
        return code
    if args.restart_shell:
        code = run_command(["omarchy", "restart", "shell"], args.dry_run)
        if code != 0:
            print("  shell restart failed; restoring the previous deployed copies", flush=True)
            rollback_deployments(changes)
            recover_deployment()
            return code
    code = verify_plugins(deploy_ids, args.dry_run)
    if code != 0:
        print("  installed-copy verification failed; restoring the previous deployed copies", flush=True)
        rollback_deployments(changes)
        recover_deployment()
        return code
    cleanup_plugin_backups()
    return 0


def deploy(args: argparse.Namespace) -> int:
    if args.dry_run:
        return _deploy(args)
    with operation_lock():
        return _deploy(args)


def _cleanup_backups(args: argparse.Namespace) -> int:
    print(f"Plugin backup cleanup (keep {max(0, args.keep)} per plugin)")
    migrated, removed = cleanup_plugin_backups(keep=args.keep, dry_run=args.dry_run)
    action = "Would migrate/remove" if args.dry_run else "Migrated/removed"
    print(f"  {action}: {migrated}/{removed}")
    return 0


def cleanup_backups(args: argparse.Namespace) -> int:
    if args.dry_run:
        return _cleanup_backups(args)
    with operation_lock():
        return _cleanup_backups(args)


def parser() -> argparse.ArgumentParser:
    base = argparse.ArgumentParser(description="Developer utilities for Lacuna Omarchy plugins.")
    subparsers = base.add_subparsers(dest="command")

    deploy_parser = subparsers.add_parser("deploy", help="Deploy working-tree plugin changes into the live Omarchy install.")
    deploy_parser.add_argument("plugins", nargs="*", help="Plugin id or comma-separated plugin ids.")
    deploy_parser.add_argument("--all", action="store_true", help="Deploy every top-level lacuna.* plugin.")
    deploy_parser.add_argument("--dry-run", action="store_true", help="Print the plan without changing live files.")
    deploy_parser.add_argument("--only-changed", action="store_true", help="Skip plugins whose installed copy already matches the repo.")
    restart = deploy_parser.add_mutually_exclusive_group()
    restart.add_argument("--restart-shell", action="store_true", default=True, help="Restart Omarchy shell after rescan (default).")
    restart.add_argument("--no-restart-shell", dest="restart_shell", action="store_false", help="Only rescan plugins; do not restart shell.")

    cleanup_parser = subparsers.add_parser("cleanup-backups", help="Move legacy deploy backups out of the plugin registry and prune old copies.")
    cleanup_parser.add_argument("--keep", type=int, default=BACKUPS_TO_KEEP, help="Rollback copies to retain per plugin (default: 2).")
    cleanup_parser.add_argument("--dry-run", action="store_true", help="Print migrations/removals without changing files.")

    return base


def main(argv: list[str] | None = None) -> int:
    args = parser().parse_args(argv)
    if args.command == "deploy":
        return deploy(args)
    if args.command == "cleanup-backups":
        return cleanup_backups(args)
    parser().print_help()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
