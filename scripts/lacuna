# Gum ships decorative foreground/background defaults. Lacuna's installer must
# inherit the terminal palette instead of painting a second hard-coded theme.
GUM_TERMINAL_STYLE = {
    "choose": [
        "--cursor.foreground=",
        "--cursor.background=",
        "--header.foreground=",
        "--header.background=",
        "--item.foreground=",
        "--item.background=",
        "--selected.foreground=",
        "--selected.background=",
    ],
    "confirm": [
        "--prompt.foreground=",
        "--prompt.background=",
        "--selected.foreground=",
        "--selected.background=",
        "--unselected.foreground=",
        "--unselected.background=",
    ],
}


@dataclass(frozen=True)
class Plugin:
    id: str
    name: str
    kinds: tuple[str, ...]
    standalone: bool
    bundle: str
    requires: tuple[str, ...]
    recommends: tuple[str, ...]
    stability: str


def config_home() -> Path:
    """XDG root for Lacuna-owned runtime state."""
    return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))


def omarchy_config_home() -> Path:
    """Config root used by Omarchy's shell and plugin host."""
    return Path(os.environ.get("LACUNA_OMARCHY_CONFIG_HOME", Path.home() / ".config"))


def plugins_dir() -> Path:
    return omarchy_config_home() / "omarchy" / "plugins"


def lacuna_state_dir() -> Path:
    return config_home() / "omarchy" / "lacuna"


def lacuna_hypr_override_paths() -> list[Path]:
    toggle_dir = Path.home() / ".local" / "state" / "omarchy" / "toggles" / "hypr"
    return [toggle_dir / name for name in LACUNA_HYPR_OVERRIDE_FILENAMES]


def load_plugins() -> dict[str, Plugin]:
    plugins: dict[str, Plugin] = {}
    for manifest_path in sorted(ROOT.glob("lacuna.*/manifest.json")):
        data = json.loads(manifest_path.read_text(encoding="utf-8"))
        meta = data.get("lacuna", {})
        stability = meta.get("stability")
        if stability not in ALLOWED_STABILITIES:
            allowed = ", ".join(sorted(ALLOWED_STABILITIES))
            raise SystemExit(
                f"{manifest_path}: lacuna.stability must be explicit and one of {allowed}; "
                f"got {stability!r}. 'stable' is reserved for a future release line."
            )
        plugin = Plugin(
            id=data["id"],
            name=data.get("name", data["id"]),
            kinds=tuple(data.get("kinds", [])),
            standalone=bool(meta.get("standalone", False)),
            bundle=meta.get("bundle", "standalone"),
            requires=tuple(meta.get("requires", [])),
            recommends=tuple(meta.get("recommends", [])),
            stability=stability,
        )
        plugins[plugin.id] = plugin
    return plugins


def read_json_object(path: Path, description: str) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except OSError as error:
        raise SystemExit(f"Could not read {description} at {path}: {error}") from error
    except json.JSONDecodeError as error:
        raise SystemExit(f"Could not parse {description} at {path}: {error}") from error
    if not isinstance(value, dict):
        raise SystemExit(f"{description} at {path} must contain a JSON object.")
    return value


def load_omakase_profile(plugins: dict[str, Plugin]) -> dict:
    profile = read_json_object(OMAKASE_PROFILE_PATH, "omakase profile")
    if profile.get("schemaVersion") != 1 or profile.get("profileId") != "omakase":
        raise SystemExit("config/omakase-profile.json must declare schemaVersion 1 and profileId 'omakase'.")
    roots = profile.get("installRoots")
    if not isinstance(roots, list) or not all(isinstance(item, str) for item in roots):
        raise SystemExit("config/omakase-profile.json installRoots must be a list of plugin ids.")
    if len(roots) != len(set(roots)):
        raise SystemExit("config/omakase-profile.json installRoots contains duplicates.")
    expected = set(plugins) - {LEGACY_PLUGIN}
    if set(roots) != expected:
        missing = sorted(expected - set(roots))
        extra = sorted(set(roots) - expected)
        raise SystemExit(
            "config/omakase-profile.json does not match the supported manifest set "
            f"(missing: {missing or 'none'}; extra: {extra or 'none'})."
        )
    if LEGACY_PLUGIN in roots:
        raise SystemExit(f"Canonical omakase install must exclude deprecated {LEGACY_PLUGIN}.")
    exclusions = profile.get("excludedRoots")
    if not isinstance(exclusions, dict) or exclusions.get("deprecated") != [LEGACY_PLUGIN]:
        raise SystemExit(f"Canonical omakase exclusions must identify deprecated {LEGACY_PLUGIN}.")
    media = profile.get("media")
    media_ids = ["lacuna.media-player", "lacuna.media-player-video"]
    if not isinstance(media, dict) or media.get("installRoots") != media_ids:
        raise SystemExit("Canonical omakase media roots must include both media plugins.")
    if media.get("activationEntries") != [{"id": item} for item in media_ids]:
        raise SystemExit("Canonical omakase media activation must include both media plugins.")
    if media.get("credentialsRequired") is not False:
        raise SystemExit("Canonical omakase media must not require provider credentials.")

    shell = profile.get("shell")
    if not isinstance(shell, dict) or shell.get("bar") != {
        "id": "lacuna.bar",
        "layout": LACUNA_BAR_LAYOUT,
        "centerAnchor": "lacuna.clock",
        "transparent": False,
    }:
        raise SystemExit("config/omakase-profile.json shell.bar does not match the canonical Lacuna bar layout.")
    if shell.get("ownedBarKeys") != ["id", "layout", "centerAnchor", "transparent"]:
        raise SystemExit("config/omakase-profile.json must own exactly the canonical four bar keys.")
    entries = shell.get("activationEntries")
    if not isinstance(entries, list) or not all(
        isinstance(entry, dict) and set(entry) == {"id"} and entry["id"] in expected
        for entry in entries
    ):
        raise SystemExit("config/omakase-profile.json shell.activationEntries is invalid.")
    entry_ids = [entry["id"] for entry in entries]
    if len(entry_ids) != len(set(entry_ids)):
        raise SystemExit("config/omakase-profile.json shell.activationEntries contains duplicates.")
    applicable = {
        plugin_id
        for plugin_id, plugin in plugins.items()
        if plugin_id != LEGACY_PLUGIN and set(plugin.kinds) & {"menu", "overlay", "service"}
    }
    if set(entry_ids) != applicable:
        raise SystemExit("config/omakase-profile.json shell.activationEntries is not the applicable omakase set.")
    preserve_shell = shell.get("preserve")
    if not isinstance(preserve_shell, dict) or preserve_shell.get("barKeysExcept") != shell["ownedBarKeys"]:
        raise SystemExit("config/omakase-profile.json shell preserve contract does not match owned bar keys.")
    if preserve_shell.get("unrelatedPluginEntries") is not True or preserve_shell.get("unknownTopLevelFields") is not True:
        raise SystemExit("Canonical reset must preserve unrelated shell entries and unknown top-level fields.")

    settings = profile.get("settings")
    if not isinstance(settings, dict):
        raise SystemExit("config/omakase-profile.json settings contract is missing.")
    if settings.get("ownedKeys") != RESET_OWNED_SETTINGS_KEYS:
        raise SystemExit("config/omakase-profile.json settings.ownedKeys does not match the reset contract.")
    if settings.get("preservedKeys") != RESET_PRESERVED_SETTINGS_KEYS:
        raise SystemExit("config/omakase-profile.json settings.preservedKeys does not match the reset contract.")
    if settings.get("preserveUnknownJsonSafeFields") is not True:
        raise SystemExit("Canonical reset must preserve unknown JSON-safe settings fields.")
    if settings.get("untouchedExternalState") != [
        "media-player.json",
        "youtube-music.json",
        "youtube/",
        "reminders.json",
    ]:
        raise SystemExit("Canonical reset external-state preservation contract is invalid.")
    defaults_name = settings.get("defaults")
    if defaults_name != "settings.example.json":
        raise SystemExit("Canonical reset defaults must come from config/settings.example.json.")
    defaults = read_json_object(OMAKASE_PROFILE_PATH.parent / defaults_name, "reset settings defaults")
    missing_defaults = [key for key in RESET_OWNED_SETTINGS_KEYS if key not in defaults]
    if missing_defaults:
        raise SystemExit(f"Reset settings defaults are missing: {', '.join(missing_defaults)}")

    reset_contract = profile.get("reset")
    if not isinstance(reset_contract, dict) or reset_contract.get("mode") != "safe-only":
        raise SystemExit("config/omakase-profile.json must define safe-only reset.")
    if reset_contract.get("purgeSupported") is not False:
        raise SystemExit("Canonical reset must not support purge mode.")
    if reset_contract.get("reloadCommand") != ["omarchy", "restart", "shell"]:
        raise SystemExit("Canonical reset reload command must be 'omarchy restart shell'.")
    if reset_contract.get("reloadCount") != 1 or reset_contract.get("atomicFileWrites") is not True:
        raise SystemExit("Canonical reset must atomically replace each file and reload exactly once.")
    if reset_contract.get("rollbackExactBytesAndModeOnReloadFailure") is not True:
        raise SystemExit("Canonical reset must restore exact bytes and modes after reload failure.")

    rehearsal = profile.get("releaseRehearsal")
    expected_prerequisites = [
        "automatic-backups",
        "verified-restoration-capability",
        "fresh-explicit-confirmation-immediately-before-destructive-steps",
    ]
    if not isinstance(rehearsal, dict) or rehearsal.get("target") != "current-user-current-machine":
        raise SystemExit("Destructive rehearsal target must be the approved current user and machine.")
    if rehearsal.get("approved") is not True or rehearsal.get("destructive") is not True:
        raise SystemExit("Destructive rehearsal approval contract is invalid.")
    if rehearsal.get("prerequisites") != expected_prerequisites or rehearsal.get("runNow") is not False:
        raise SystemExit("Destructive rehearsal safeguards must be recorded without authorizing execution now.")

    profile["_settingsDefaults"] = defaults
    return profile


def plugin_order(plugins: dict[str, Plugin]) -> list[str]:
    order: list[str] = []
    for ids in PROFILE_IDS.values():
        for plugin_id in ids:
            if plugin_id in plugins and plugin_id not in order:
                order.append(plugin_id)
    for plugin_id in sorted(plugins):
        if plugin_id not in order:
            order.append(plugin_id)
    return order


def ordered(ids: set[str], plugins: dict[str, Plugin]) -> list[str]:
    priority = plugin_order(plugins)
    return [plugin_id for plugin_id in priority if plugin_id in ids]


def dependency_closure(ids: set[str], plugins: dict[str, Plugin]) -> set[str]:
    resolved = set(ids)
    changed = True
    while changed:
        changed = False
        for plugin_id in list(resolved):
            plugin = plugins.get(plugin_id)
            if not plugin:
                continue
            for required in plugin.requires:
                if required not in resolved:
                    resolved.add(required)
                    changed = True
    return resolved


def reverse_dependency_closure(ids: set[str], installed: set[str], plugins: dict[str, Plugin]) -> set[str]:
    resolved = set(ids)
    changed = True
    while changed:
        changed = False
        for plugin_id in installed - resolved:
            plugin = plugins.get(plugin_id)
            if plugin and any(required in resolved for required in plugin.requires):
                resolved.add(plugin_id)
                changed = True
    return resolved


def full_profile(plugins: dict[str, Plugin], include_legacy: bool, _include_replacements: bool) -> set[str]:
    ids = set(load_omakase_profile(plugins)["installRoots"])
    if include_legacy and LEGACY_PLUGIN in plugins:
        ids.add(LEGACY_PLUGIN)
    return ids


def profile_ids(profile: str, plugins: dict[str, Plugin], include_legacy: bool, include_replacements: bool) -> set[str]:
    if profile == "full":
        return full_profile(plugins, include_legacy, include_replacements)
    return {plugin_id for plugin_id in PROFILE_IDS[profile] if plugin_id in plugins}


def installed_lacuna_plugins(plugins: dict[str, Plugin]) -> list[str]:
    base = plugins_dir()
    if not base.exists():
        return []
    ids = []
    for plugin_id in plugins:
        target = base / plugin_id
        if target.exists() or target.is_symlink():
            ids.append(plugin_id)
    return ordered(set(ids), plugins)


def manifest_version(path: Path) -> str:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return "unknown"
    value = data.get("version")
    return str(value) if value else "unknown"


def repo_plugin_version(plugin_id: str) -> str:
    return manifest_version(ROOT / plugin_id / "manifest.json")


def installed_plugin_version(plugin_id: str) -> str:
    return manifest_version(plugins_dir() / plugin_id / "manifest.json")


def relative_payload_paths(base: Path) -> set[Path]:
    paths: set[Path] = set()
    if not base.exists():
        return paths
    for root, dirs, files in os.walk(base):
        dirs[:] = [name for name in dirs if name != "__pycache__"]
        root_path = Path(root)
        for name in files:
            if name == "__pycache__":
                continue
            paths.add((root_path / name).relative_to(base))
    return paths


def plugin_source_differs(plugin_id: str) -> bool:
    source = ROOT / plugin_id
    target = plugins_dir() / plugin_id
    if not source.is_dir() or not target.is_dir():
        return True

    source_paths = relative_payload_paths(source)
    target_paths = relative_payload_paths(target)
    if source_paths != target_paths:
        return True

    for relative in source_paths:
        source_path = source / relative
        target_path = target / relative
        if source_path.is_symlink() or target_path.is_symlink():
            if not source_path.is_symlink() or not target_path.is_symlink():
                return True
            if os.readlink(source_path) != os.readlink(target_path):
                return True
        elif not filecmp.cmp(source_path, target_path, shallow=False):
            return True
    return False


def has_gum() -> bool:
    return shutil.which("gum") is not None and sys.stdin.isatty() and sys.stdout.isatty()


def gum_command(args: list[str]) -> list[str]:
    if not args:
        return ["gum"]
    command, *rest = args
    return ["gum", command, *GUM_TERMINAL_STYLE.get(command, []), *rest]


def run_gum(args: list[str], input_text: str | None = None) -> str | None:
    try:
        result = subprocess.run(
            gum_command(args),
            input=input_text,
            text=True,
            stdout=subprocess.PIPE,
            stderr=None,
            check=False,
        )
    except OSError:
        return None
    if result.returncode != 0:
        return None
    return result.stdout.strip()


def choose(title: str, choices: list[str]) -> str | None:
    if has_gum():
        return run_gum(["choose", f"--header={title}", *choices])
    print(f"\n{title}")
    for index, choice in enumerate(choices, 1):
        print(f"  {index}. {choice}")
    reply = input("> ").strip()
    if not reply:
        return None
    try:
        return choices[int(reply) - 1]
    except (ValueError, IndexError):
        return None


def multi_choose(title: str, choices: list[str]) -> list[str]:
    if has_gum():
        result = run_gum(["choose", "--no-limit", f"--header={title}", *choices])
        return result.splitlines() if result else []
    print(f"\n{title}")
    for index, choice in enumerate(choices, 1):
        print(f"  {index}. {choice}")
    print("Enter numbers separated by spaces.")
    reply = input("> ").strip()
    selected: list[str] = []
    for token in reply.split():
        try:
            selected.append(choices[int(token) - 1])
        except (ValueError, IndexError):
            continue
    return selected


def confirm(prompt: str, assume_yes: bool) -> bool:
    if assume_yes:
        return True
    if has_gum():
        print(f"\nWaiting for confirmation: {prompt}", flush=True)
        return run_gum(["confirm", prompt]) is not None
    if not sys.stdin.isatty():
        return False
    return input(f"{prompt} [y/N] ").strip().lower().startswith("y")


def label(plugin: Plugin) -> str:
    text = f"{plugin.id} - {plugin.name}"
    if plugin.stability != "stable":
        text += f" [{plugin.stability}]"
    return text


def id_from_label(value: str) -> str:
    return value.split(" - ", 1)[0]


def source_exists(source: str) -> bool | None:
    try:
        result = subprocess.run(
            ["omarchy", "plugin", "source", "list", "--json"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except OSError:
        return None
    if result.returncode != 0:
        return None
    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError:
        return None
    return any(entry.get("id") == source for entry in data.get("sources", []))


def default_source_url() -> str | None:
    if (ROOT / ".git").exists():
        return str(ROOT)
    return OFFICIAL_SOURCE_URL


def source_catalog_ids() -> set[str] | None:
    try:
        result = subprocess.run(
            ["omarchy-plugin-scan"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    except OSError:
        return None
    if result.returncode != 0:
        return None
    try:
        entries = json.loads(result.stdout)
    except json.JSONDecodeError:
        return None
    ids: set[str] = set()
    for entry in entries:
        manifest = entry.get("manifest", {})
        plugin_id = manifest.get("id")
        if isinstance(plugin_id, str):
            ids.add(plugin_id)
    return ids


def checkout_contains_plugins(selected_ids: list[str]) -> bool:
    return all((ROOT / plugin_id / "manifest.json").exists() for plugin_id in selected_ids)


def verify_source_catalog(source: str, selected_ids: list[str]) -> int:
    catalog = source_catalog_ids()
    if catalog is None:
        print("Could not verify Omarchy's source catalog; continuing with install attempt.")
        return 0
    missing = [plugin_id for plugin_id in selected_ids if plugin_id not in catalog]
    if not missing:
        return 0

    if checkout_contains_plugins(selected_ids):
        print("\nOmarchy's source catalog is stale, but this checkout contains the selected plugins.")
        print("Continuing with the local checkout payload.")
        return 0

    print(f"\nSource '{source}' is configured, but Omarchy does not see the selected Lacuna plugins.")
    print("This usually means the source cache points at an older repo state.")
    print("\nRepair this local checkout source with:")
    print(f"  omarchy plugin source remove {source} --yes")
    print(f"  omarchy plugin source add {ROOT} --as {source} --yes")
    print("\nThen rerun the installer.")
    print(f"\nFirst missing plugin: {missing[0]}")
    return 1


def print_plan(title: str, ids: list[str], plugins: dict[str, Plugin]) -> None:
    print(f"\n{title}")
    if not ids:
        print("  Nothing selected.")
        return
    for plugin_id in ids:
        plugin = plugins[plugin_id]
        kind_text = ", ".join(plugin.kinds) or "plugin"
        print(f"  - {plugin.id} ({kind_text})")


def stage_commands(ids: list[str], rescan: bool = True) -> list[str]:
    commands = [f"stage {plugin_id} -> {plugins_dir() / plugin_id}" for plugin_id in ids]
    if ids and rescan:
        commands.append("omarchy plugin rescan")
    return commands


def shell_config_path() -> Path:
    return omarchy_config_home() / "omarchy" / "shell.json"


def default_shell_config() -> dict:
    return {
        "version": 1,
        "bar": {"layout": {"left": [], "center": [], "right": []}},
        "plugins": [],
    }


def stock_shell_config() -> dict:
    for path in OMARCHY_STOCK_SHELL_CONFIG_PATHS:
        if not path.exists():
            continue
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            continue
        if isinstance(data, dict):
            return ensure_shell_config_shape(data)
    return {
        "version": 1,
        "bar": {
            "centerAnchor": "omarchy.clock",
            "layout": {
                "left": [{"id": "omarchy.menu"}, {"id": "omarchy.workspaces"}],
                "center": [{"id": "omarchy.clock", "format": "dddd HH:mm"}],
                "right": [{"id": "omarchy.audio"}],
            },
        },
        "plugins": [],
    }


def read_shell_config() -> dict:
    path = shell_config_path()
    if not path.exists():
        return default_shell_config()
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        raise SystemExit(f"Could not parse {path}: {error}") from error
    if not isinstance(data, dict):
        raise SystemExit(f"{path} must contain a JSON object.")
    return data


def ensure_shell_config_shape(config: dict) -> dict:
    config.setdefault("version", 1)
    bar = config.setdefault("bar", {})
    if not isinstance(bar, dict):
        config["bar"] = bar = {}
    layout = bar.setdefault("layout", {})
    if not isinstance(layout, dict):
        bar["layout"] = layout = {}
    for section in ("left", "center", "right"):
        if not isinstance(layout.get(section), list):
            layout[section] = []
    if not isinstance(config.get("plugins"), list):
        config["plugins"] = []
    return config


def atomic_write_json(path: Path, config: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = json.dumps(config, indent=2) + "\n"
    existing_mode = (path.stat().st_mode & 0o7777) if path.is_file() else None
    temporary: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=path.parent,
            prefix=f".{path.name}.tmp.",
            delete=False,
        ) as stream:
            temporary = Path(stream.name)
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        if existing_mode is not None:
            temporary.chmod(existing_mode)
        os.replace(temporary, path)
        temporary = None
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def write_shell_config(config: dict) -> None:
    atomic_write_json(shell_config_path(), config)


def settings_config_path() -> Path:
    return lacuna_state_dir() / "settings.json"


def runtime_state_paths() -> list[Path]:
    return [shell_config_path(), settings_config_path()]


def preserve_runtime_state() -> list[Path]:
    """Copy mutable shell/runtime state before an install or update."""
    existing = [path for path in runtime_state_paths() if path.exists() or path.is_symlink()]
    if not existing:
        return []

    backup_dir = lacuna_state_dir() / "backups"
    backup_dir.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")
    saved: list[Path] = []
    for path in existing:
        backup = backup_dir / f"{path.name}.{timestamp}.bak"
        suffix = 1
        while backup.exists() or backup.is_symlink():
            backup = backup_dir / f"{path.name}.{timestamp}-{suffix}.bak"
            suffix += 1
        if path.is_symlink():
            backup.symlink_to(os.readlink(path))
        else:
            shutil.copy2(path, backup)
        saved.append(backup)

    backups = sorted(backup_dir.glob("*.bak"), key=lambda item: (item.stat().st_mtime, item.name), reverse=True)
    for backup in backups[RUNTIME_BACKUPS_TO_KEEP * len(existing):]:
        remove_path(backup)

    print("  preserved runtime state:")
    for backup in saved:
        print(f"    {backup}")
    return saved


def capture_path_state(path: Path) -> dict[str, object]:
    if path.is_symlink():
        return {"kind": "symlink", "target": os.readlink(path)}
    if path.is_file():
        return {"kind": "file", "data": path.read_bytes(), "mode": path.stat().st_mode & 0o7777}
    return {"kind": "missing"}


def restore_path_state(path: Path, state: dict[str, object]) -> None:
    remove_path(path)
    kind = state.get("kind")
    if kind == "symlink":
        path.parent.mkdir(parents=True, exist_ok=True)
        path.symlink_to(str(state["target"]))
    elif kind == "file":
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(state["data"])
        mode = state.get("mode")
        if isinstance(mode, int):
            path.chmod(mode)


def path_matches_state(path: Path, state: dict[str, object]) -> bool:
    kind = state.get("kind")
    if kind == "missing":
        return not path.exists() and not path.is_symlink()
    if kind == "symlink":
        return path.is_symlink() and os.readlink(path) == state.get("target")
    if kind == "file" and path.is_file() and not path.is_symlink():
        mode = path.stat().st_mode & 0o7777
        return path.read_bytes() == state.get("data") and mode == state.get("mode")
    return False


def reset_external_file_states(profile: dict) -> dict[Path, dict[str, object]]:
    states: dict[Path, dict[str, object]] = {}
    for relative in profile["settings"]["untouchedExternalState"]:
        candidate = Path(relative)
        if candidate.is_absolute() or ".." in candidate.parts:
            raise ValueError(f"Unsafe reset preservation path: {relative}")
        # Directories are already outside reset ownership. Capture files that a
        # shell shutdown/startup can rewrite while reset is in progress.
        if str(relative).endswith("/"):
            continue
        path = lacuna_state_dir() / candidate
        states[path] = capture_path_state(path)
    return states


def restore_changed_path_states(states: dict[Path, dict[str, object]]) -> list[Path]:
    restored: list[Path] = []
    for path, state in states.items():
        if path_matches_state(path, state):
            continue
        restore_path_state(path, state)
        restored.append(path)
    return restored


def entry_id(entry: object) -> str | None:
    if isinstance(entry, dict) and isinstance(entry.get("id"), str):
        return entry["id"]
    return None


def remove_shell_entries(config: dict, plugin_id: str) -> list[dict]:
    removed: list[dict] = []
    layout = config["bar"]["layout"]
    for section in ("left", "center", "right"):
        kept = []
        for entry in layout[section]:
            if entry_id(entry) == plugin_id:
                if isinstance(entry, dict):
                    removed.append(entry)
            else:
                kept.append(entry)
        layout[section] = kept

    kept_plugins = []
    for entry in config["plugins"]:
        if entry_id(entry) == plugin_id:
            if isinstance(entry, dict):
                removed.append(entry)
        else:
            kept_plugins.append(entry)
    config["plugins"] = kept_plugins

    if config["bar"].get("id") == plugin_id:
        del config["bar"]["id"]

    return removed


def restore_stock_bar_config(config: dict) -> None:
    current_bar = config.get("bar", {})
    if not isinstance(current_bar, dict):
        current_bar = {}

    stock_bar = stock_shell_config().get("bar", {})
    if not isinstance(stock_bar, dict):
        stock_bar = default_shell_config()["bar"]
    stock_bar = json.loads(json.dumps(stock_bar))

    for key, value in current_bar.items():
        if key not in {"id", "layout", "centerAnchor"}:
            stock_bar[key] = value

    stock_bar.pop("id", None)
    config["bar"] = stock_bar
    ensure_shell_config_shape(config)


def has_shell_entry(config: dict, plugin_id: str) -> bool:
    if config["bar"].get("id") == plugin_id:
        return True
    layout = config["bar"]["layout"]
    for section in ("left", "center", "right"):
        if any(entry_id(entry) == plugin_id for entry in layout[section]):
            return True
    return any(entry_id(entry) == plugin_id for entry in config["plugins"])


def is_bar_widget(plugin: Plugin) -> bool:
    return "bar-widget" in plugin.kinds


def is_bar_option(plugin: Plugin) -> bool:
    return "bar" in plugin.kinds


def enable_shell_entry(config: dict, plugin: Plugin) -> None:
    if is_bar_option(plugin):
        config["bar"]["id"] = plugin.id
    elif is_bar_widget(plugin):
        removed = remove_shell_entries(config, plugin.id)
        entry = next((item for item in removed if entry_id(item) == plugin.id), {"id": plugin.id})
        config["bar"]["layout"]["right"].append(entry)
    elif not has_shell_entry(config, plugin.id):
        config["plugins"].append({"id": plugin.id})


AMBIENCE_HOST_ID = "lacuna.ambience-host"
AMBIENCE_FALLBACK_IDS = {
    "lacuna.aurora-drift",
    "lacuna.cinematic-light-overlay",
    "lacuna.crt-overlay",
    "lacuna.dust-motes-overlay",
    "lacuna.film-grain-overlay",
    "lacuna.god-rays-overlay",
    "lacuna.rainfall-overlay",
    "lacuna.vhs-overlay",
}


def order_ambience_host_before_fallbacks(config: dict) -> None:
    entries = config["plugins"]
    host_entries = [entry for entry in entries if entry_id(entry) == AMBIENCE_HOST_ID]
    if not host_entries:
        return
    host_entry = host_entries[0]
    remaining = [entry for entry in entries if entry_id(entry) != AMBIENCE_HOST_ID]
    first_fallback = next(
        (index for index, entry in enumerate(remaining) if entry_id(entry) in AMBIENCE_FALLBACK_IDS),
        len(remaining),
    )
    remaining.insert(first_fallback, host_entry)
    config["plugins"] = remaining


def layout_template_entries() -> list[tuple[str, int, dict]]:
    entries: list[tuple[str, int, dict]] = []
    for section in ("left", "center", "right"):
        for index, item in enumerate(LACUNA_BAR_LAYOUT[section]):
            entries.append((section, index, dict(item)))
    return entries


def example_layout_entries() -> list[tuple[str, int, dict]]:
    path = ROOT / "config" / "shell.lacuna-native-replacements.example.json"
    data = json.loads(path.read_text(encoding="utf-8"))
    entries: list[tuple[str, int, dict]] = []
    for section in ("left", "center", "right"):
        for index, item in enumerate(data.get("bar", {}).get("layout", {}).get(section, [])):
            plugin_id = item.get("id") if isinstance(item, dict) else None
            if isinstance(plugin_id, str) and plugin_id.startswith("lacuna."):
                entries.append((section, index, dict(item)))
    return entries


def apply_layout_to_config(config: dict, selected: set[str]) -> None:
    for section, index, template_entry in example_layout_entries():
        plugin_id = template_entry["id"]
        if plugin_id not in selected:
            continue
        removed = remove_shell_entries(config, plugin_id)
        entry = next((item for item in removed if entry_id(item) == plugin_id), template_entry)
        for key, value in template_entry.items():
            entry.setdefault(key, value)
        target = config["bar"]["layout"][section]
        target.insert(min(index, len(target)), entry)


def apply_lacuna_bar_layout_to_config(config: dict, available: set[str]) -> None:
    removed_by_id: dict[str, dict] = {}
    layout = config["bar"]["layout"]
    for section in ("left", "center", "right"):
        for item in layout[section]:
            plugin_id = entry_id(item)
            if plugin_id and plugin_id in LACUNA_BAR_LAYOUT_PLUGIN_IDS and isinstance(item, dict):
                removed_by_id.setdefault(plugin_id, item)
            if plugin_id and plugin_id in OMARCHY_TO_LACUNA_REPLACEMENTS and isinstance(item, dict):
                lacuna_id = OMARCHY_TO_LACUNA_REPLACEMENTS[plugin_id]
                migrated = dict(item)
                migrated["id"] = lacuna_id
                removed_by_id.setdefault(lacuna_id, migrated)
        layout[section] = []

    for section, index, template_entry in layout_template_entries():
        plugin_id = template_entry["id"]
        if plugin_id.startswith("lacuna.") and plugin_id not in available:
            continue
        entry = removed_by_id.get(plugin_id, dict(template_entry))
        for key, value in template_entry.items():
            entry.setdefault(key, value)
        target = config["bar"]["layout"][section]
        target.insert(min(index, len(target)), entry)
    pin_bar_size_toggle_last(layout["right"])
    config["bar"]["centerAnchor"] = "lacuna.clock"
    # Lacuna's unified bar/frame surface is deliberately opaque. Keep the
    # persisted shell setting aligned with the behavior instead of retaining a
    # stock-bar transparency request that Lacuna does not implement.
    config["bar"]["transparent"] = False


def validate_reset_shell_input(config: dict) -> None:
    bar = config.get("bar")
    if bar is not None and not isinstance(bar, dict):
        raise SystemExit(f"{shell_config_path()} bar must be a JSON object before reset.")
    if isinstance(bar, dict) and "layout" in bar and not isinstance(bar["layout"], dict):
        raise SystemExit(f"{shell_config_path()} bar.layout must be a JSON object before reset.")
    if "plugins" in config and not isinstance(config["plugins"], list):
        raise SystemExit(f"{shell_config_path()} plugins must be a JSON array before reset.")


def apply_omakase_shell_config(
    config: dict,
    profile: dict,
    known_plugin_ids: set[str],
) -> dict:
    canonical_bar = profile["shell"]["bar"]
    bar = config.setdefault("bar", {})
    for key in profile["shell"]["ownedBarKeys"]:
        bar[key] = copy.deepcopy(canonical_bar[key])

    current_entries = config.get("plugins", [])
    unrelated_entries = [
        entry
        for entry in current_entries
        if entry_id(entry) not in known_plugin_ids
    ]
    config["plugins"] = unrelated_entries + copy.deepcopy(profile["shell"]["activationEntries"])
    return config


def merge_reset_defaults(current: object, defaults: object) -> object:
    """Reset known default fields while retaining unknown nested JSON fields."""
    if isinstance(defaults, dict):
        merged = copy.deepcopy(current) if isinstance(current, dict) else {}
        for key, value in defaults.items():
            merged[key] = merge_reset_defaults(merged.get(key), value)
        return merged
    return copy.deepcopy(defaults)


def apply_omakase_settings(current: dict, profile: dict) -> dict:
    merged = copy.deepcopy(current)
    defaults = profile["_settingsDefaults"]
    for key in profile["settings"]["ownedKeys"]:
        merged[key] = merge_reset_defaults(merged.get(key), defaults[key])
    return merged


def pin_bar_size_toggle_last(entries: list[dict]) -> None:
    toggles = [entry for entry in entries if entry_id(entry) == "lacuna.bar-size-pill"]
    if not toggles:
        return
    entries[:] = [entry for entry in entries if entry_id(entry) != "lacuna.bar-size-pill"]
    entries.extend(toggles)


def activation_reload_command(selected: set[str]) -> list[str]:
    if "lacuna.bar" in selected:
        return ["omarchy", "restart", "shell"]
    return ["omarchy", "plugin", "rescan"]


def activation_reload_label(selected: set[str]) -> str:
    command = activation_reload_command(selected)
    return " ".join(command)


def activate_plugins(
    ids: list[str],
    plugins: dict[str, Plugin],
    selected: set[str],
    apply_layout_choice: bool,
    dry_run: bool,
    changes: list[tuple[Path, Path | None]] | None = None,
    omakase_profile: dict | None = None,
) -> int:
    if not ids:
        return 0
    if dry_run:
        print(f"  update {shell_config_path()} once")
        if "lacuna.bar" in selected:
            print("  apply Lacuna bar host layout in shell.json")
        print(f"  {activation_reload_label(selected)}")
        return 0

    shell_path = shell_config_path()
    shell_state = capture_path_state(shell_path)
    try:
        config = ensure_shell_config_shape(read_shell_config())
        if omakase_profile is not None:
            apply_omakase_shell_config(config, omakase_profile, set(plugins))
        else:
            for plugin_id in ids:
                enable_shell_entry(config, plugins[plugin_id])
            if AMBIENCE_HOST_ID in selected:
                order_ambience_host_before_fallbacks(config)
            if "lacuna.bar" in selected or config["bar"].get("id") == "lacuna.bar":
                available = selected | set(installed_lacuna_plugins(plugins))
                apply_lacuna_bar_layout_to_config(config, available)
            if apply_layout_choice:
                apply_layout_to_config(config, selected)
        write_shell_config(config)
        print(f"  updated {shell_config_path()}", flush=True)
        code = run_reload_command(activation_reload_command(selected), dry_run)
        if code == 0:
            return 0
        print("  activation reload failed; restoring the previous shell.json", flush=True)
        restore_path_state(shell_path, shell_state)
        reload_after_rollback(selected)
        return code
    except (OSError, ValueError, SystemExit) as error:
        restore_path_state(shell_path, shell_state)
        print(f"Failed to activate Lacuna plugins: {error}", file=sys.stderr)
        return 1


def deactivate_plugins(ids: list[str], dry_run: bool) -> int:
    if not ids:
        return 0
    if dry_run:
        print(f"  update {shell_config_path()} once")
        return 0

    shell_path = shell_config_path()
    shell_state = capture_path_state(shell_path)
    try:
        config = ensure_shell_config_shape(read_shell_config())
        for plugin_id in ids:
            remove_shell_entries(config, plugin_id)
        if "lacuna.bar" in ids:
            restore_stock_bar_config(config)
        write_shell_config(config)
        print(f"  updated {shell_config_path()}", flush=True)
        return 0
    except (OSError, ValueError, SystemExit) as error:
        restore_path_state(shell_path, shell_state)
        print(f"Failed to update shell configuration: {error}", file=sys.stderr)
        return 1


def uninstall_reload_command(ids: list[str]) -> list[str]:
    if "lacuna.bar" in ids:
        return ["omarchy", "restart", "shell"]
    return ["omarchy", "plugin", "rescan"]


def uninstall_reload_label(ids: list[str]) -> str:
    return " ".join(uninstall_reload_command(ids))


def activation_commands(ids: list[str], apply_layout_choice: bool = False) -> list[str]:
    commands = []
    if ids:
        commands.append(f"update {shell_config_path()} once")
        if "lacuna.bar" in ids:
            commands.append("apply Lacuna bar host layout in shell.json")
        if apply_layout_choice:
            commands.append("apply Lacuna bar layout in shell.json")
        commands.append(activation_reload_label(set(ids)))
    return commands


def uninstall_stage_commands(ids: list[str], cleanup_hypr_overrides: bool = False) -> list[str]:
    commands = []
    if ids:
        commands.append(f"update {shell_config_path()} once")
    if "lacuna.bar" in ids:
        commands.append("restore stock Omarchy bar layout in shell.json")
    for plugin_id in ids:
        commands.append(f"remove {plugins_dir() / plugin_id}")
    if cleanup_hypr_overrides:
        commands.append(f"remove Lacuna Hyprland overrides from {lacuna_hypr_override_paths()[0].parent}")
        commands.append("hyprctl reload")
    if ids:
        commands.append(uninstall_reload_label(ids))
    return commands


def print_stage_commands(commands: list[str]) -> None:
    for command in commands:
        print("  " + command)


def run_command(command: list[str], dry_run: bool, timeout_seconds: int = 60) -> int:
    if dry_run:
        print("  " + " ".join(command))
        return 0
    print("  " + " ".join(command), flush=True)
    try:
        return subprocess.run(command, check=False, timeout=timeout_seconds).returncode
    except subprocess.TimeoutExpired:
        print(f"Command timed out after {timeout_seconds}s: {' '.join(command)}")
        return 124
    except OSError as error:
        print(f"Could not run {' '.join(command)}: {error}", file=sys.stderr)
        return 127


def omarchy_shell_process_ids() -> set[int]:
    """Return Omarchy Quickshell PIDs without matching unrelated configs."""
    shell_dir = str(Path(os.environ.get("OMARCHY_PATH", "/usr/share/omarchy")) / "shell")
    pids: set[int] = set()
    for proc in Path("/proc").glob("[0-9]*"):
        try:
            argv = (proc / "cmdline").read_bytes().split(b"\0")
        except OSError:
            continue
        decoded = [part.decode(errors="replace") for part in argv if part]
        if not decoded or Path(decoded[0]).name not in {"quickshell", "qs"}:
            continue
        if any(decoded[index] == "-p" and index + 1 < len(decoded) and decoded[index + 1] == shell_dir for index in range(len(decoded))):
            pids.add(int(proc.name))
    return pids


def shell_ping_ready() -> bool:
    try:
        result = subprocess.run(
            ["omarchy-shell", "shell", "ping"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=1,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0


def run_reload_command(command: list[str], dry_run: bool) -> int:
    """Accept a host restart timeout only when a new shell becomes healthy."""
    before = omarchy_shell_process_ids() if not dry_run and command == ["omarchy", "restart", "shell"] else set()
    code = run_command(command, dry_run)
    if code == 0 or dry_run or command != ["omarchy", "restart", "shell"]:
        return code
    new_pids = omarchy_shell_process_ids() - before
    if not new_pids:
        return code
    for _attempt in range(30):
        if shell_ping_ready():
            print("  Omarchy shell became ready after the restart helper timed out.", flush=True)
            return 0
        time.sleep(0.1)
    return code


def run_commands(commands: list[list[str]], dry_run: bool) -> int:
    for command in commands:
        code = run_command(command, dry_run)
        if code != 0:
            return code
    return 0


def remove_path(path: Path) -> None:
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.exists():
        shutil.rmtree(path)


def backup_target(target: Path) -> Path | None:
    if not target.exists() and not target.is_symlink():
        return None

    timestamp = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")
    base = target.parent / f".{target.name}.bak.{timestamp}"
    backup = base
    suffix = 1
    while backup.exists():
        backup = target.parent / f"{base.name}-{suffix}"
        suffix += 1
    shutil.move(str(target), str(backup))
    prune_backups(target.name)
    return backup


def prune_backups(plugin_id: str, keep: int = BACKUPS_TO_KEEP) -> None:
    if keep < 0:
        keep = 0
    base = plugins_dir()
    backups = sorted(
        base.glob(f".{plugin_id}.bak.*"),
        key=lambda path: (path.stat().st_mtime, path.name),
        reverse=True,
    )
    for backup in backups[keep:]:
        remove_path(backup)


def validate_plugin(plugin_id: str, source_dir: Path, dry_run: bool) -> int:
    command = ["omarchy", "plugin", "validate", str(source_dir)]
    if dry_run:
        print("  " + " ".join(command))
        return 0
    return run_command(command, dry_run=False)


def stage_plugin(
    plugin_id: str,
    dry_run: bool,
    reinstall: bool,
    changes: list[tuple[Path, Path | None]] | None = None,
) -> int:
    source_dir = ROOT / plugin_id
    target = plugins_dir() / plugin_id
    if not source_dir.is_dir():
        print(f"Missing plugin source directory: {source_dir}")
        return 1
    if (target.exists() or target.is_symlink()) and not reinstall:
        print(f"  {plugin_id} already staged")
        return 0

    print(f"  stage {plugin_id} -> {target}", flush=True)
    code = validate_plugin(plugin_id, source_dir, dry_run)
    if code != 0:
        return code
    if dry_run:
        return 0

    target.parent.mkdir(parents=True, exist_ok=True)
    stage = Path(tempfile.mkdtemp(prefix=f".{plugin_id}.tmp.", dir=target.parent))
    backup = None
    try:
        shutil.copytree(
            source_dir,
            stage,
            symlinks=True,
            dirs_exist_ok=True,
            ignore=shutil.ignore_patterns("__pycache__"),
        )
        backup = backup_target(target)
        shutil.move(str(stage), str(target))
        if changes is not None:
            changes.append((target, backup))
    except BaseException as error:
        remove_path(stage)
        if backup and backup.exists() and not target.exists():
            shutil.move(str(backup), str(target))
        if not isinstance(error, Exception):
            raise
        print(f"Failed to stage {plugin_id}: {error}")
        return 1
    if backup:
        print(f"    previous install backed up to {backup}")
    return 0


def rollback_staged_changes(changes: list[tuple[Path, Path | None]]) -> None:
    for target, backup in reversed(changes):
        remove_path(target)
        if backup and (backup.exists() or backup.is_symlink()):
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(backup), str(target))


def reload_after_rollback(selected: set[str] | None = None) -> int:
    command = activation_reload_command(selected or set())
    print(f"  recovery: {' '.join(command)}", flush=True)
    return run_reload_command(command, dry_run=False)


def stage_plugins(
    ids: list[str],
    dry_run: bool,
    reinstall: bool,
    rescan: bool = True,
    changes: list[tuple[Path, Path | None]] | None = None,
) -> int:
    transaction = changes if changes is not None else []
    start = len(transaction)
    for plugin_id in ids:
        code = stage_plugin(plugin_id, dry_run, reinstall, transaction)
        if code != 0:
            rollback_staged_changes(transaction[start:])
            del transaction[start:]
            return code
    if ids and rescan:
        code = run_command(["omarchy", "plugin", "rescan"], dry_run)
        if code != 0:
            print("  plugin rescan failed; restoring the previous staged copies", flush=True)
            rollback_staged_changes(transaction[start:])
            del transaction[start:]
            if not dry_run:
                reload_after_rollback()
            return code
    return 0


def remove_plugin(
    plugin_id: str,
    dry_run: bool,
    changes: list[tuple[Path, Path | None]] | None = None,
) -> int:
    target = plugins_dir() / plugin_id
    print(f"  remove {target}", flush=True)
    if dry_run:
        return 0
    if not target.exists() and not target.is_symlink():
        print(f"    {plugin_id} is not installed")
        return 0
    backup = backup_target(target)
    if changes is not None:
        changes.append((target, backup))
    if backup:
        print(f"    backed up to {backup}")
    else:
        print(f"    removed {plugin_id}")
    return 0


def validate_lacuna_hypr_override_paths() -> bool:
    for path in lacuna_hypr_override_paths():
        if path.exists() and not path.is_file() and not path.is_symlink():
            print(f"Refusing to remove non-file Hyprland override path: {path}", file=sys.stderr)
            return False
    return True


def remove_lacuna_hypr_overrides(dry_run: bool) -> None:
    for path in lacuna_hypr_override_paths():
        if dry_run or path.exists() or path.is_symlink():
            print(f"  remove {path}", flush=True)
        if not dry_run and (path.exists() or path.is_symlink()):
            if not path.is_file() and not path.is_symlink():
                raise IsADirectoryError(f"refusing to recursively remove override path: {path}")
            path.unlink()


def uninstall_plugins(ids: list[str], dry_run: bool, cleanup_hypr_overrides: bool = False) -> int:
    if cleanup_hypr_overrides and not dry_run and not validate_lacuna_hypr_override_paths():
        return 1
    shell_path = shell_config_path()
    shell_state = capture_path_state(shell_path) if not dry_run else {"kind": "missing"}
    override_states = {
        path: capture_path_state(path)
        for path in lacuna_hypr_override_paths()
    } if cleanup_hypr_overrides and not dry_run else {}
    code = deactivate_plugins(ids, dry_run)
    if code != 0:
        return code
    removed: list[tuple[Path, Path | None]] = []

    def rollback() -> None:
        restore_path_state(shell_path, shell_state)
        rollback_staged_changes(removed)
        for path, state in override_states.items():
            restore_path_state(path, state)
        if cleanup_hypr_overrides:
            run_reload_command(["hyprctl", "reload"], dry_run=False)
        reload_after_rollback(set(ids))

    try:
        for plugin_id in ids:
            code = remove_plugin(plugin_id, dry_run, removed)
            if code != 0:
                if not dry_run:
                    print("  uninstall failed; restoring the previous plugin and shell state", flush=True)
                    rollback()
                return code
        if cleanup_hypr_overrides:
            remove_lacuna_hypr_overrides(dry_run)
            code = run_reload_command(["hyprctl", "reload"], dry_run)
            if code != 0:
                if not dry_run:
                    print("  Hyprland reload failed; restoring the previous override, plugin, and shell state", flush=True)
                    rollback()
                return code
        if ids:
            code = run_reload_command(uninstall_reload_command(ids), dry_run)
            if code != 0 and not dry_run:
                print("  uninstall reload failed; restoring the previous override, plugin, and shell state", flush=True)
                rollback()
            return code
    except OSError as error:
        print(f"Failed to remove Lacuna files: {error}", file=sys.stderr)
        if not dry_run:
            rollback()
        return 1
    return 0


def ensure_source(source: str, source_url: str | None, dry_run: bool, assume_yes: bool) -> int:
    exists = False if dry_run else source_exists(source)
    if exists is True:
        return 0
    if exists is None and not dry_run:
        print("Could not verify Omarchy plugin sources; continuing with install attempt.")
        return 0

    url = source_url or default_source_url()
    if not url:
        print(f"Plugin source '{source}' is not configured.")
        print(f"Add it first: omarchy plugin source add <repo-url> --as {source}")
        return 1

    command = ["omarchy", "plugin", "source", "add", url, "--as", source]
    if assume_yes:
        command.append("--yes")
    print(f"\nPlugin source '{source}' is not configured.")
    if not confirm(f"Add trusted plugin source '{source}' from {url}?", assume_yes):
        print(f"Add it later with: omarchy plugin source add {url} --as {source}")
        return 1
    print("\nAdding plugin source")
    print("This clones the trusted source into Omarchy's plugin cache and can take a moment.", flush=True)
    return run_command(command, dry_run)


def resolve_install_selection(args: argparse.Namespace, plugins: dict[str, Plugin]) -> set[str]:
    if args.plugins:
        selected = {item for value in args.plugins for item in value.split(",") if item}
    else:
        selected = profile_ids(args.profile, plugins, args.include_legacy, args.include_replacements)

    unknown = sorted(selected - set(plugins))
    if unknown:
        raise SystemExit(f"Unknown Lacuna plugin id: {', '.join(unknown)}")

    selected = dependency_closure(selected, plugins)
    if args.include_recommended:
        for plugin_id in list(selected):
            selected.update(plugins[plugin_id].recommends)
        selected = dependency_closure(selected, plugins)
    if not args.include_legacy:
        selected.discard(LEGACY_PLUGIN)
    return selected


def preflight_install_selection(
    ids: list[str],
    selected: set[str],
    installed: set[str],
    plugins: dict[str, Plugin],
    activate_choice: bool,
) -> int:
    """Check the dependency and core-host contract before staging anything."""
    selected_or_installed = set(selected) | set(installed)
    missing: set[str] = set()
    missing_sources: set[str] = set()
    for plugin_id in ids:
        plugin = plugins[plugin_id]
        for required in plugin.requires:
            if required not in selected_or_installed:
                missing.add(f"{plugin_id} requires {required}")
        if not (ROOT / plugin_id / "manifest.json").is_file():
            missing_sources.add(plugin_id)

    if activate_choice and "lacuna.bar" in selected:
        core = dependency_closure({"lacuna.bar"}, plugins)
        missing_core = sorted(core - selected_or_installed)
        missing.update(f"lacuna.bar core companion missing: {plugin_id}" for plugin_id in missing_core)

    if missing_sources:
        missing.update(f"source missing: {plugin_id}" for plugin_id in sorted(missing_sources))

    print("\nPreflight")
    if missing:
        print("  FAILED")
        for problem in sorted(missing):
            print(f"  - {problem}")
        return 1
    print("  dependencies and core bundle are satisfied")
    print("  source manifests are present")
    return 0


def is_default_full_install(args: argparse.Namespace) -> bool:
    return args.profile == "full" and not args.plugins


def apply_full_install_defaults(args: argparse.Namespace) -> None:
    if not is_default_full_install(args):
        return
    args.include_replacements = True
    if args.activate is None:
        args.activate = True
    if args.apply_layout is None:
        args.apply_layout = True


def install(args: argparse.Namespace) -> int:
    apply_full_install_defaults(args)
    plugins = load_plugins()
    omakase_profile = (
        load_omakase_profile(plugins)
        if is_default_full_install(args) and not args.include_legacy
        else None
    )
    selected = resolve_install_selection(args, plugins)
    ids = ordered(selected, plugins)
    installed = set(installed_lacuna_plugins(plugins))
    install_ids = ids if args.reinstall else [plugin_id for plugin_id in ids if plugin_id not in installed]
    source_state = None if args.dry_run else source_exists(args.source)

    apply_layout_choice = args.apply_layout
    if apply_layout_choice is None:
        apply_layout_choice = False

    activate_choice = args.activate
    if activate_choice is None and not args.yes and not args.dry_run:
        activate_choice = confirm(
            "Enable selected Lacuna plugins now? Full activation reloads the shell once.",
            False,
        )
    elif activate_choice is None:
        activate_choice = False

    fallback_refresh_ids = (
        ordered(installed & AMBIENCE_FALLBACK_IDS, plugins)
        if activate_choice is True and AMBIENCE_HOST_ID in selected
        else []
    )
    stage_ids = list(dict.fromkeys([*install_ids, *fallback_refresh_ids]))

    if preflight_install_selection(ids, selected, installed, plugins, bool(activate_choice)) != 0:
        return 1

    print_plan("Install plan", ids, plugins)
    if installed and not args.reinstall:
        already = [plugin_id for plugin_id in ids if plugin_id in installed]
        if already:
            print("\nAlready installed; will not reinstall unless --reinstall is passed:")
            for plugin_id in already:
                print(f"  - {plugin_id}")
    if source_state is False:
        print(f"\nSource '{args.source}' is not configured yet; the installer will offer to add it before installing.")
    commands = stage_commands(stage_ids, rescan=not activate_choice)
    print("\nCommands")
    if commands:
        print_stage_commands(commands)
        if fallback_refresh_ids and not args.reinstall:
            print("  refresh installed ambience fallbacks before host activation")
    else:
        print("  No plugin copy commands needed.")

    if activate_choice:
        print("\nActivation")
        if args.dry_run:
            print_stage_commands(activation_commands(ids, apply_layout_choice))
        else:
            print(f"  Will update shell.json once for {len(ids)} selected Lacuna plugins.")
        if apply_layout_choice:
            if not args.dry_run:
                print("  Will apply the recommended Lacuna bar layout in the same shell.json update.")
    elif apply_layout_choice:
        print("\nLayout was requested, but plugins will not be enabled. Re-run with --activate --apply-layout to apply it.")

    if args.dry_run:
        return 0
    if not confirm("Install selected Lacuna plugins?", args.yes):
        print("Install cancelled.")
        return 1
    code = ensure_source(args.source, args.source_url, args.dry_run, args.yes)
    if code != 0:
        return code
    code = verify_source_catalog(args.source, ids)
    if code != 0:
        return code
    if not args.dry_run:
        preserve_runtime_state()

    code = 0
    transaction: list[tuple[Path, Path | None]] = []
    if stage_ids:
        code = stage_plugins(
            stage_ids,
            args.dry_run,
            args.reinstall or bool(fallback_refresh_ids),
            rescan=not activate_choice,
            changes=transaction,
        )
        if code != 0:
            return code
    if activate_choice:
        code = activate_plugins(
            ids,
            plugins,
            selected,
            apply_layout_choice,
            args.dry_run,
            transaction,
            omakase_profile=omakase_profile,
        )
        if code != 0 and transaction:
            print("  rolling back staged plugins after activation failure", flush=True)
            rollback_staged_changes(transaction)
            reload_after_rollback(selected)
            transaction.clear()
    else:
        print("\nInstalled files are staged but disabled.")
        print("Enable a smaller profile first, for example:")
        print("  ./scripts/lacuna install --profile core --activate")
    return code


def uninstall(args: argparse.Namespace) -> int:
    plugins = load_plugins()
    if args.plugins:
        selected = {item for value in args.plugins for item in value.split(",") if item}
    elif args.all:
        selected = set(installed_lacuna_plugins(plugins))
    else:
        if sys.stdin.isatty() and not args.yes and not args.dry_run:
            next_args = uninstall_menu(args)
            return uninstall(next_args) if next_args else 0
        print("Refusing to uninstall every Lacuna plugin implicitly. Pass --all or --plugin.", file=sys.stderr)
        return 2

    unknown = sorted(selected - set(plugins))
    if unknown:
        raise SystemExit(f"Unknown Lacuna plugin id: {', '.join(unknown)}")

    installed = set(installed_lacuna_plugins(plugins))
    cascade = reverse_dependency_closure(selected, installed, plugins)
    dependents = cascade - selected
    if dependents and not args.cascade:
        print("Refusing to break installed plugin dependencies.", file=sys.stderr)
        print(f"Also remove: {', '.join(ordered(dependents, plugins))}", file=sys.stderr)
        print("Re-run with --cascade to remove the dependent plugins too.", file=sys.stderr)
        return 2
    if dependents:
        selected = cascade

    ids = ordered(selected, plugins)
    full_uninstall = args.all and not args.plugins
    cleanup_hypr_overrides = (full_uninstall or "lacuna.shell-settings" in ids) and (
        args.dry_run or any(path.exists() or path.is_symlink() for path in lacuna_hypr_override_paths())
    )
    print_plan("Uninstall plan", ids, plugins)
    commands = uninstall_stage_commands(ids, cleanup_hypr_overrides)
    if commands:
        print("\nCommands")
        print_stage_commands(commands)
    if args.purge_state:
        print(f"\nPurge state: {lacuna_state_dir()}")

    if args.dry_run:
        return 0
    if not ids and not args.purge_state and not cleanup_hypr_overrides:
        print("No installed Lacuna plugins or Hyprland overrides found.")
        return 0
    if not confirm("Remove selected Lacuna plugins?", args.yes):
        print("Uninstall cancelled.")
        return 1
    preserve_runtime_state()
    code = uninstall_plugins(ids, args.dry_run, cleanup_hypr_overrides)
    if code != 0:
        return code
    if args.purge_state:
        state_dir = lacuna_state_dir()
        if state_dir.exists() and confirm(f"Delete Lacuna runtime state at {state_dir}?", args.yes):
            shutil.rmtree(state_dir)
            print(f"Deleted {state_dir}")
    return 0


def resolve_update_selection(args: argparse.Namespace, plugins: dict[str, Plugin]) -> list[str]:
    installed = set(installed_lacuna_plugins(plugins))
    if args.plugins:
        selected = {item for value in args.plugins for item in value.split(",") if item}
        unknown = sorted(selected - set(plugins))
        if unknown:
            raise SystemExit(f"Unknown Lacuna plugin id: {', '.join(unknown)}")

        missing = ordered(selected - installed, plugins)
        for plugin_id in missing:
            print(f"  {plugin_id} is not installed; skipping.")
        selected &= installed
    else:
        selected = installed
    return ordered(selected, plugins)


def update(args: argparse.Namespace) -> int:
    plugins = load_plugins()
    ids = resolve_update_selection(args, plugins)
    update_ids = [plugin_id for plugin_id in ids if plugin_source_differs(plugin_id)]

    print_plan("Update plan", update_ids, plugins)
    if ids and len(update_ids) != len(ids):
        unchanged = [plugin_id for plugin_id in ids if plugin_id not in update_ids]
        print(f"\nAlready current: {len(unchanged)} plugin(s)")

    print("\nCommands")
    commands = stage_commands(update_ids, rescan=True)
    if commands:
        print_stage_commands(commands)
    else:
        print("  No plugin copy commands needed.")

    if args.dry_run:
        return 0
    if not update_ids:
        print("\nNo installed Lacuna plugins need updates.")
        for plugin_id in ids:
            prune_backups(plugin_id)
        return 0
    if not confirm("Update changed Lacuna plugins?", args.yes):
        print("Update cancelled.")
        return 1
    preserve_runtime_state()
    for plugin_id in ids:
        prune_backups(plugin_id)
    transaction: list[tuple[Path, Path | None]] = []
    code = stage_plugins(update_ids, args.dry_run, reinstall=True, rescan=True, changes=transaction)
    if code != 0:
        return code
    return 0


def missing_omakase_install_roots(profile: dict) -> list[str]:
    base = plugins_dir()
    return [
        plugin_id
        for plugin_id in profile["installRoots"]
        if not (base / plugin_id).is_dir()
    ]


def reset_install_preflight(profile: dict) -> bool:
    missing = missing_omakase_install_roots(profile)
    if not missing:
        return True
    print("Reset refused: the canonical omakase plugin set is not fully installed.", file=sys.stderr)
    print("Missing plugin roots:", file=sys.stderr)
    for plugin_id in missing:
        print(f"  - {plugin_id}", file=sys.stderr)
    print("Recovery: ./scripts/lacuna install --yes", file=sys.stderr)
    return False


def build_reset_outputs(profile: dict, plugins: dict[str, Plugin]) -> tuple[dict, dict]:
    shell_config = read_shell_config()
    validate_reset_shell_input(shell_config)
    settings_path = settings_config_path()
    current_settings = (
        read_json_object(settings_path, "Lacuna settings")
        if settings_path.exists() or settings_path.is_symlink()
        else {}
    )
    next_shell = apply_omakase_shell_config(shell_config, profile, set(plugins))
    next_settings = apply_omakase_settings(current_settings, profile)
    return next_shell, next_settings


def reset(args: argparse.Namespace) -> int:
    plugins = load_plugins()
    profile = load_omakase_profile(plugins)
    settings_path = settings_config_path()

    if not reset_install_preflight(profile):
        return 2

    print("Omakase reset plan")
    print(f"  snapshot {shell_config_path()}")
    print(f"  snapshot {settings_path}")
    print("  restore canonical Lacuna activation and exact bar layout")
    print("  reset approved presentation/runtime settings from config/settings.example.json")
    print("  preserve credentials, provider configuration, user data, unrelated plugins, and unknown JSON fields")
    print(f"  {' '.join(profile['reset']['reloadCommand'])} (exactly once)")
    if args.dry_run:
        build_reset_outputs(profile, plugins)
        return 0
    if not confirm("Reset Lacuna activation, layout, and presentation settings to omakase defaults?", args.yes):
        print("Reset cancelled.")
        return 1
    if not reset_install_preflight(profile):
        return 2

    # Confirmation may take arbitrarily long. Capture and re-read only after it
    # returns so preserved state cannot be overwritten from a stale plan.
    shell_path = shell_config_path()
    shell_state = capture_path_state(shell_path)
    settings_state = capture_path_state(settings_path)
    external_states = reset_external_file_states(profile)
    next_shell, next_settings = build_reset_outputs(profile, plugins)
    preserve_runtime_state()
    try:
        atomic_write_json(shell_path, next_shell)
        atomic_write_json(settings_path, next_settings)
    except (OSError, ValueError) as error:
        restore_path_state(shell_path, shell_state)
        restore_path_state(settings_path, settings_state)
        restore_changed_path_states(external_states)
        print(f"Reset write failed; restored the exact previous state: {error}", file=sys.stderr)
        return 1

    try:
        code = run_reload_command(profile["reset"]["reloadCommand"], dry_run=False)
    except OSError as error:
        restore_path_state(shell_path, shell_state)
        restore_path_state(settings_path, settings_state)
        restore_changed_path_states(external_states)
        print(f"Reset reload could not start; restored exact previous bytes and modes: {error}", file=sys.stderr)
        return 1
    if code != 0:
        restore_path_state(shell_path, shell_state)
        restore_path_state(settings_path, settings_state)
        restore_changed_path_states(external_states)
        print("Reset reload failed; restored exact previous bytes and modes.", file=sys.stderr)
        return code
    restored_external = restore_changed_path_states(external_states)
    if restored_external:
        print("  restored preserved state changed during shell reload:")
        for path in restored_external:
            print(f"    {path}")
    print("Omakase reset complete. Preserved state was not modified.")
    return 0


def package_version(*names: str) -> str:
    for name in names:
        try:
            result = subprocess.run(
                ["pacman", "-Q", name],
                check=False,
                capture_output=True,
                text=True,
            )
        except OSError:
            return "not detected"
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout.strip()
    return "not detected"


def installer_status_path() -> Path:
    return lacuna_state_dir() / "installer-status.json"


def write_installer_status(operation: str, phase: str, exit_code: int | None = None) -> None:
    path = installer_status_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = {
        "operation": operation,
        "phase": phase,
        "exitCode": exit_code,
        "updatedAt": datetime.now(timezone.utc).isoformat(),
        "recovery": "lacuna-shell status; omarchy plugin rescan; omarchy restart shell",
    }
    temporary: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=path.parent,
            prefix=f".{path.name}.tmp.",
            delete=False,
        ) as stream:
            temporary = Path(stream.name)
            stream.write(json.dumps(payload, indent=2) + "\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        temporary = None
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def read_optional_json(path: Path) -> tuple[dict | None, str]:
    if not path.exists():
        return None, "missing"
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None, "invalid"
    return (value, "healthy") if isinstance(value, dict) else (None, "invalid")


def status(_args: argparse.Namespace) -> int:
    plugins = load_plugins()
    installed = set(installed_lacuna_plugins(plugins))
    shell_health = "healthy"
    try:
        shell_config = ensure_shell_config_shape(read_shell_config())
        enabled = {plugin_id for plugin_id in plugins if has_shell_entry(shell_config, plugin_id)}
    except SystemExit:
        shell_config = default_shell_config()
        enabled = set()
        shell_health = "invalid"

    settings, settings_health = read_optional_json(lacuna_state_dir() / "settings.json")
    operation, operation_health = read_optional_json(installer_status_path())
    sidebar = settings.get("sidebar", {}) if settings else {}
    policy = sidebar.get("monitorPolicy", "auto") if isinstance(sidebar, dict) else "auto"
    names = sidebar.get("monitorNames", []) if isinstance(sidebar, dict) else []
    if not isinstance(names, list):
        names = []

    core = dependency_closure({"lacuna.bar"}, plugins)
    missing_core = ordered(core - installed, plugins)
    disabled_core = ordered((core & installed) - enabled, plugins)
    stale_core = [plugin_id for plugin_id in ordered(core & installed, plugins)
                  if installed_plugin_version(plugin_id) != repo_plugin_version(plugin_id)]

    print("Lacuna status")
    print(f"  Omarchy host: {package_version('omarchy-dev', 'omarchy')}")
    print(f"  Quickshell host: {package_version('quickshell-git', 'quickshell')}")
    print(f"  Omarchy config: {omarchy_config_home() / 'omarchy'}")
    print(f"  Lacuna state: {lacuna_state_dir()}")
    print(f"  Shell config: {shell_health} ({shell_config_path()})")
    schema = settings.get("version", "unknown") if settings else "unknown"
    print(f"  Settings migration: {settings_health} (schema {schema}, expected 1)")
    print(f"  Sidebar monitor policy: {policy} ({', '.join(map(str, names)) if names else 'no pinned outputs'})")
    if operation_health == "healthy" and operation:
        print(f"  Last installer operation: {operation.get('operation', 'unknown')} / {operation.get('phase', 'unknown')} / exit {operation.get('exitCode')}")
        print(f"  Recovery: {operation.get('recovery', 'omarchy plugin rescan; omarchy restart shell')}")
    else:
        print(f"  Last installer operation: {operation_health}")
        print("  Recovery: omarchy plugin rescan; omarchy restart shell")
    print(f"  Core health: missing {len(missing_core)}, disabled {len(disabled_core)}, stale {len(stale_core)}")
    if missing_core: print(f"    missing: {', '.join(missing_core)}")
    if disabled_core: print(f"    disabled: {', '.join(disabled_core)}")
    if stale_core: print(f"    stale: {', '.join(stale_core)}")
    source_state = source_exists(DEFAULT_SOURCE)
    print(f"  Source configured: {'unknown' if source_state is None else source_state}")
    print(f"  Installed plugins: {len(installed)}")
    for plugin_id in ordered(installed, plugins):
        state = "enabled" if plugin_id in enabled else "staged"
        installed_version = installed_plugin_version(plugin_id)
        repo_version = repo_plugin_version(plugin_id)
        print(f"  - {plugin_id} ({state}) installed {installed_version}, repo {repo_version}")
    if not installed:
        print("  No Lacuna plugins are installed.")
    return 0


def custom_install_menu(args: argparse.Namespace) -> argparse.Namespace | None:
    plugins = load_plugins()
    selected: set[str] = set()
    group_choices = [PROFILE_LABELS[key] for key in PROFILE_IDS]
    picked_groups = multi_choose("Choose Lacuna groups to install", group_choices)
    reverse = {value: key for key, value in PROFILE_LABELS.items()}
    for group in picked_groups:
        selected.update(PROFILE_IDS[reverse[group]])

    standalone = [
        label(plugin)
        for plugin in plugins.values()
        if plugin.standalone and plugin.id not in selected
    ]
    picked_plugins = multi_choose("Add individual standalone plugins", sorted(standalone))
    selected.update(id_from_label(item) for item in picked_plugins)

    if not selected:
        print("Nothing selected.")
        return None
    args.profile = "core"
    args.plugins = [",".join(sorted(selected))]
    args.include_recommended = True
    return args


def uninstall_menu(args: argparse.Namespace) -> argparse.Namespace | None:
    plugins = load_plugins()
    installed = installed_lacuna_plugins(plugins)
    if not installed:
        if any(path.exists() or path.is_symlink() for path in lacuna_hypr_override_paths()):
            print("No installed Lacuna plugins found; stale Lacuna Hyprland overrides will be removed.")
            args.all = True
            return args
        print("No installed Lacuna plugins or Hyprland overrides found.")
        return None
    action = choose("Uninstall Lacuna", ["Remove all Lacuna plugins", "Choose plugins", "Cancel"])
    if action == "Remove all Lacuna plugins":
        args.all = True
        return args
    if action == "Choose plugins":
        picked = multi_choose("Choose installed plugins to remove", [label(plugins[item]) for item in installed])
        if not picked:
            return None
        args.plugins = [",".join(id_from_label(item) for item in picked)]
        return args
    return None


def menu(args: argparse.Namespace) -> int:
    action = choose(
        "Lacuna",
        [
            "Full Lacuna install",
            "Custom install",
            "Update installed Lacuna plugins",
            "Reset Lacuna to omakase defaults",
            "Uninstall Lacuna",
            "Status",
            "Exit",
        ],
    )
    if action == "Full Lacuna install":
        args.command = "install"
        args.profile = "full"
        args.plugins = []
        args.include_recommended = False
        args.include_replacements = True
        args.activate = True
        args.apply_layout = True
        print("\nFull install will stage and activate the Lacuna Bar setup.")
        print("It will select lacuna.bar, apply the Lacuna bar layout, and restart Omarchy shell once.")
        return run_mutation(install, args)
    if action == "Custom install":
        args.command = "install"
        next_args = custom_install_menu(args)
        return run_mutation(install, next_args) if next_args else 0
    if action == "Update installed Lacuna plugins":
        args.command = "update"
        return run_mutation(update, args)
    if action == "Reset Lacuna to omakase defaults":
        args.command = "reset"
        return run_reset(args)
    if action == "Uninstall Lacuna":
        args.command = "uninstall"
        next_args = uninstall_menu(args)
        return run_mutation(uninstall, next_args) if next_args else 0
    if action == "Status":
        return status(args)
    return 0


def common_parser() -> argparse.ArgumentParser:
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--source", default=argparse.SUPPRESS, help="Omarchy plugin source id. Default: lacuna")
    common.add_argument("--source-url", default=argparse.SUPPRESS, help="Git URL to add when the source is missing.")
    common.add_argument(
        "--dry-run",
        action="store_true",
        default=argparse.SUPPRESS,
        help="Print the plan and commands without changing anything.",
    )
    common.add_argument("--yes", "-y", action="store_true", default=argparse.SUPPRESS, help="Skip confirmation prompts.")
    common.add_argument(
        "--include-legacy",
        action="store_true",
        default=argparse.SUPPRESS,
        help="Include legacy bundle plugins.",
    )
    common.add_argument(
        "--include-replacements",
        action="store_true",
        default=argparse.SUPPRESS,
        help="Include Lacuna replacements for native Omarchy bar widgets in the full profile.",
    )
    return common


def parser() -> argparse.ArgumentParser:
    common = common_parser()
    base = argparse.ArgumentParser(
        description="Install, safely reset, uninstall, and inspect Lacuna Omarchy plugins.",
        parents=[common],
    )

    subparsers = base.add_subparsers(dest="command")

    install_parser = subparsers.add_parser("install", parents=[common], help="Install Lacuna plugins.")
    install_parser.add_argument("--profile", choices=["full", *PROFILE_IDS.keys()], default="full")
    install_parser.add_argument("--plugin", dest="plugins", action="append", default=[], help="Plugin id or comma list.")
    install_parser.add_argument("--include-recommended", action="store_true", help="Include recommended companion plugins.")
    install_parser.add_argument("--reinstall", action="store_true", help="Replace plugins that are already installed.")
    activate = install_parser.add_mutually_exclusive_group()
    activate.add_argument("--activate", action="store_true", default=None, help="Enable plugins after installing them.")
    activate.add_argument("--no-activate", dest="activate", action="store_false", help="Install files but leave plugins disabled.")
    layout = install_parser.add_mutually_exclusive_group()
    layout.add_argument("--apply-layout", action="store_true", default=None, help="Apply the recommended Lacuna bar layout.")
    layout.add_argument("--keep-layout", dest="apply_layout", action="store_false", help="Do not modify the bar layout.")

    uninstall_parser = subparsers.add_parser("uninstall", parents=[common], help="Uninstall Lacuna plugins.")
    uninstall_parser.add_argument("--all", action="store_true", help="Remove all installed Lacuna plugins.")
    uninstall_parser.add_argument("--plugin", dest="plugins", action="append", default=[], help="Plugin id or comma list.")
    uninstall_parser.add_argument("--cascade", action="store_true", help="Also remove installed plugins that require the selection.")
    uninstall_parser.add_argument("--purge-state", action="store_true", help="Also remove ~/.config/omarchy/lacuna after confirmation.")

    update_parser = subparsers.add_parser("update", parents=[common], help="Restage installed Lacuna plugins that changed in this checkout.")
    update_parser.add_argument("--plugin", dest="plugins", action="append", default=[], help="Plugin id or comma list.")

    subparsers.add_parser("reset", parents=[common], help="Safely restore canonical Lacuna activation, layout, and settings.")
    subparsers.add_parser("status", parents=[common], help="Show installed Lacuna plugins.")
    return base


def normalize_args(args: argparse.Namespace) -> argparse.Namespace:
    if not hasattr(args, "source"):
        args.source = DEFAULT_SOURCE
    if not hasattr(args, "source_url"):
        args.source_url = None
    if not hasattr(args, "dry_run"):
        args.dry_run = False
    if not hasattr(args, "yes"):
        args.yes = False
    if not hasattr(args, "include_legacy"):
        args.include_legacy = False
    if not hasattr(args, "include_replacements"):
        args.include_replacements = False
    if not hasattr(args, "plugins"):
        args.plugins = []
    if not hasattr(args, "profile"):
        args.profile = "full"
    if not hasattr(args, "include_recommended"):
        args.include_recommended = False
    if not hasattr(args, "reinstall"):
        args.reinstall = False
    if not hasattr(args, "activate"):
        args.activate = None
    if not hasattr(args, "apply_layout"):
        args.apply_layout = None
    if not hasattr(args, "all"):
        args.all = False
    if not hasattr(args, "cascade"):
        args.cascade = False
    if not hasattr(args, "purge_state"):
        args.purge_state = False
    return args


@contextmanager
def installer_transaction_lock():
    """Serialize each complete installer mutation, including reload and rollback."""
    lock_path = omarchy_config_home() / "omarchy" / "lacuna-installer.lock"
    lock_path.parent.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


def run_mutation(operation, args: argparse.Namespace) -> int:
    if args.dry_run:
        return operation(args)
    operation_name = str(getattr(operation, "__name__", "mutation"))
    with installer_transaction_lock():
        write_installer_status(operation_name, "running")
        try:
            code = operation(args)
        except BaseException:
            write_installer_status(operation_name, "exception", 1)
            raise
        write_installer_status(operation_name, "completed" if code == 0 else "failed", code)
        return code


def run_reset(args: argparse.Namespace) -> int:
    if args.dry_run:
        return reset(args)
    # Refuse an incomplete installation before creating the transaction lock or
    # touching any runtime state. reset() repeats this check inside the lock.
    plugins = load_plugins()
    profile = load_omakase_profile(plugins)
    if not reset_install_preflight(profile):
        return 2
    with installer_transaction_lock():
        return reset(args)


def dispatch(args: argparse.Namespace) -> int:
    if args.command == "install":
        return run_mutation(install, args)
    if args.command == "uninstall":
        return run_mutation(uninstall, args)
    if args.command == "update":
        return run_mutation(update, args)
    if args.command == "reset":
        return run_reset(args)
    if args.command == "status":
        return status(args)
    if sys.stdin.isatty():
        return menu(args)
    parser().print_help()
    return 0


def main(argv: list[str] | None = None) -> int:
    args = normalize_args(parser().parse_args(argv))
    try:
        return dispatch(args)
    except KeyboardInterrupt:
        print("\nInterrupted. Installed plugins may be staged; check with: omarchy plugin list")
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
