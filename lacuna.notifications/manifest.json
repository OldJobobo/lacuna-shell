{
  "schemaVersion": 1,
  "id": "lacuna.notifications",
  "name": "Lacuna Notifications",
  "version": "0.1.0-beta.5",
  "author": "Lacuna",
  "description": "Lacuna-styled notification center control for the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "Lacuna Notifications",
    "description": "Shows pending notification and DND state.",
    "category": "Lacuna",
    "allowMultiple": false,
    "defaults": {
      "colorProfile": "semantic"
    },
    "schema": [
      {
        "key": "colorProfile",
        "type": "enum",
        "label": "Color profile",
        "options": [
          "semantic",
          "colorful"
        ],
        "description": "Override the global Lacuna color profile for this widget.",
        "defaultValue": "semantic"
      }
    ]
  },
  "lacuna": {
    "standalone": true,
    "bundle": "standalone",
    "requires": [],
    "recommends": [],
    "stability": "beta"
  }
}
